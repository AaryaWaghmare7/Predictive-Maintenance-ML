# Local operation needs no secrets. Variables are read from the process
# environment, not automatically from this file. Never commit a real token.
EVISION_MODE=local
EVISION_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required only for an explicitly approved production service; generate securely.
# EVISION_API_TOKEN=<random-ASCII-token-at-least-32-characters>
